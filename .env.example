APP_NAME="Tahdi Altalabeh API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (local or hosted)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tahdi_altalabeh
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# CORS — comma-separated frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# SPA URL for password reset links and Google OAuth return
FRONTEND_URL=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Queue (database driver is fine for local development)
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file

# AI provider — backend only (openai or gemini)
AI_PROVIDER=openai

# OpenAI (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_VALIDATION_MODEL=gpt-4o-mini
OPENAI_LEGACY_MODEL=gpt-3.5-turbo

# Gemini (when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_VALIDATION_MODEL=gemini-3.5-flash-lite
GEMINI_LEGACY_MODEL=gemini-3.5-flash-lite

# Curriculum review-set generation (Phase E)
TARGET_QUESTIONS_PER_UNIT=60
QUESTIONS_PER_REVIEW_SET=20
MIN_PLAYABLE_REVIEW_SET_SIZE=15
QUESTIONS_PER_POINT_TIER=4
DUPLICATE_SIMILARITY_THRESHOLD=0.85
CROSS_SET_DUPLICATE_THRESHOLD=0.80
ANSWER_SIMILARITY_THRESHOLD=0.90
MAX_GENERATION_ATTEMPTS_MULTIPLIER=3

# Play set AI generation (user games)
PLAY_SET_QUESTION_COUNT=20
PLAY_SET_QUESTIONS_PER_POINT_TIER=4
PLAY_SET_SOURCE_EXCERPT_MAX_CHARS=12000
PLAY_SET_SOURCE_STORE_MAX_CHARS=100000
PLAY_SET_GENERATION_MAX_ATTEMPTS=3

# AI rate limiting
RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=30

# Legacy Node textbook pipeline proxy (optional; Laravel handles textbooks directly when disabled)
NODE_LEGACY_ENABLED=false
NODE_LEGACY_URL=http://127.0.0.1:4000
NODE_LEGACY_TIMEOUT=300

# Textbook PDF extraction / OCR (optional Poppler + Tesseract for TOC pages)
# Windows setup helper: backend/scripts/setup-windows-textbook-ocr.ps1
TEXTBOOK_OCR_ENABLED=true
TEXTBOOK_OCR_DPI=200
TEXTBOOK_OCR_LANGUAGE=ara
TEXTBOOK_FRONT_MATTER_PAGES=30
TEXTBOOK_MAX_OCR_PAGES=25
# TESSERACT_PATH=
# PDFTOPPM_PATH=
# PDFTOTEXT_PATH=
